	partition 'Coverage Matrix' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "coverage_matrix.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"typology", type text}, {"rule_id", type text}, {"share_detected", type number}, {"visible_attempts", Int64.Type}, {"documented_target", type logical}}, "en-US")
				in
					Typed
