	partition Rule = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "rule.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"rule_id", type text}, {"name", type text}, {"typology", type text}, {"threshold", Int64.Type}, {"lookback_days", Int64.Type}}, "en-US")
				in
					Typed
