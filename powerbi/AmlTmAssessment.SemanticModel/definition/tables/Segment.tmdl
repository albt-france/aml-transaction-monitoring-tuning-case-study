table Segment
	lineageTag: 2837e65d-4cc6-50b5-ae86-12cece57903d

	column segment
		dataType: string
		lineageTag: 79db8390-acca-5bb3-9255-dc6207c5884b
		summarizeBy: none
		sourceColumn: segment

	partition Segment = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "segment.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"segment", type text}}, "en-US")
				in
					Typed
