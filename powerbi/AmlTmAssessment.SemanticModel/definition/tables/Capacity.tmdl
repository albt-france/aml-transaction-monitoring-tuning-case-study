	partition Capacity = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "capacity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"wk", Int64.Type}, {"days_in_week", Int64.Type}, {"analysts", Int64.Type}, {"hours_available", type number}, {"alert_capacity", Int64.Type}, {"alerts_implemented", Int64.Type}, {"alerts_tuned", Int64.Type}, {"load_implemented", type number}, {"load_tuned", type number}, {"hours_needed_implemented", type number}}, "en-US")
