	partition Alerts = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "alerts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"scenario", type text}, {"rule_id", type text}, {"day", type date}, {"wk", Int64.Type}, {"segment", type text}, {"is_tp", Int64.Type}, {"payroll_driven", type logical}, {"decision", type text}, {"handling_minutes", type number}}, "en-US")
				in
					Typed
