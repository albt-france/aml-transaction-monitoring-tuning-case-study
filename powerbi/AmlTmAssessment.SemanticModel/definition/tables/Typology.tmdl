table Typology
	lineageTag: bfea0907-5b11-539a-bf16-ff771d5d4ad2

	column typology
		dataType: string
		lineageTag: 162b4277-41c7-5363-aba2-1b3186901ae3
		summarizeBy: none
		sourceColumn: typology

	partition Typology = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "typology.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"typology", type text}}, "en-US")
				in
					Typed
